# NarrativeWatch AI - Environment Configuration

# ==================== DATABASE ====================
# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/narrativewatch

# ==================== VERTEX AI ====================
# Google Cloud Project
VERTEX_AI_PROJECT_ID=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# LLM Model
LLM_PROVIDER=vertex
LLM_MODEL=gemini-2.5-pro

# ==================== EMBEDDINGS ====================
# Vertex AI Embeddings
EMBEDDING_PROVIDER=vertex
EMBEDDING_MODEL=text-embedding-005

# ==================== EXTERNAL APIs ====================
# Tavily Search
TAVILY_API_KEY=your-tavily-api-key

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token

# Twitter API (optional)
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# ==================== BACKUP LLM (Optional) ====================
# Claude API (fallback)
CLAUDE_API_KEY=your-claude-api-key

# ==================== APPLICATION ====================
# FastAPI
APP_NAME=NarrativeWatch AI
APP_ENV=development
DEBUG=True

# API Port
API_PORT=8000

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ==================== SECURITY ====================
# Secret Key (generate with: python -c "import secrets; print(secrets.token_urlsafe())")
SECRET_KEY=change-me-to-a-secure-random-key

# CORS Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ==================== FEATURES ====================
# Enable/Disable Features
ENABLE_RAG=true
ENABLE_RESEARCH_AGENT=true
ENABLE_REFLECTION_LOOP=true
MAX_REFLECTION_RETRIES=3
